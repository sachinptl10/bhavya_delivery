# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bhavya-express?retryWrites=true&w=majority

# JWT Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Credentials (Get from Razorpay dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Comma-separated list of emails allowed to sign in as admin via Google
ADMIN_WHITELIST_EMAILS=admin@example.com

# URLs (used for CORS and OAuth redirects)
VITE_FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
