# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bhavya-express?retryWrites=true&w=majority

# JWT Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Credentials (Get from Razorpay dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
